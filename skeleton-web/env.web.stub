
# --- Vistas (renderizado en servidor) -----------------------------------
# Prefijo de las rutas #[Page] y de los archivos de Public/. Normalmente es
# el RewriteBase: las páginas quedan en /mi-sitio/... y el API en BASE_PATH.
WEB_BASE_PATH={{WEB_BASE_PATH}}

# Nombre del sitio: sufijo del <title> («Inicio | Mi Sitio») y og:site_name.
APP_NAME="{{APP_NAME}}"

# Esquema y dominio públicos, sin ruta: https://midominio.com
# Se usa para el canonical y las URLs de Open Graph. Vacío = se toma del Host
# de la petición, que sirve en desarrollo pero no debe usarse en producción.
APP_URL=

# Idioma del sitio: <html lang> y og:locale.
APP_LOCALE=es_CR

# Valores por defecto de las páginas que no declaren los suyos en new Seo().
# La imagen es una ruta dentro de Public/ o una URL absoluta.
SEO_DEFAULT_DESCRIPTION=
SEO_DEFAULT_IMAGE=
